package tests;

use ecosystem::regexp::examples::basic as application;
use ecosystem::regexp;
use std::testing;

#[test]
fn imported_regexp_syntax() -> () {
    application::exercise();
}

#[test]
fn downstream_streams_captures_without_materializing_all_matches() -> () {
    let regex = testing::expect_ok(regexp::Regex::compile("([0-9]+)"), "compile");
    let input = "a12 b34";
    let cursor = testing::expect_ok(regex.find_iter(input), "iterator");
    let captures: Vec[string] = Vec::new();
    for found in cursor {
        captures.push(
            testing::expect_some(testing::expect_ok(found, "match").capture(input, 1), "capture"),
        );
    }
    testing::assert(captures == Vec::from_array(["12", "34"]));
}

#[test]
fn downstream_lazy_split_handles_unicode_fields() -> () {
    let regex = testing::expect_ok(regexp::Regex::compile("[ ,]+"), "regex");
    let fields: Vec[string] = Vec::new();
    for field in testing::expect_ok(regex.split_iter("a, é 😀"), "split") {
        fields.push(testing::expect_ok(field, "field"));
    }
    testing::assert(fields == Vec::from_array(["a", "é", "😀"]));
}

#[test]
fn downstream_literal_replacement_accepts_user_supplied_dollars() -> () {
    let regex = testing::expect_ok(regexp::Regex::compile("[0-9]+"), "regex");
    testing::assert_eq(
        testing::expect_ok(regex.replace_all_literal("price=42", "$1😀"), "literal"),
        "price=$1😀",
    );
}
